<idea-plugin>
    <id>org.redesnac.wilfriedmbouenda.kmp-ios-build-doctor</id>
    <name>KMP iOS Build Doctor</name>
    <vendor email="opensource@redesnac.org" url="https://github.com/redesnac/kmp-ios-build-doctor">wilfriedmbouenda Contributors</vendor>

    <description>
        Diagnoses Kotlin Multiplatform iOS build setup issues directly from Android Studio and IntelliJ IDEA.
        The plugin inspects Gradle, KMP targets, Kotlin/Native cache, and Xcode DerivedData signals, then recommends
        the safest next action for a working iOS build.
    </description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="KMP iOS Doctor"
            anchor="right"
            factoryClass="org.redesnac.wilfriedmbouenda.plugin.ui.DoctorToolWindowFactory"
            icon="/icons/doctor.svg"/>
        <projectService serviceImplementation="org.redesnac.wilfriedmbouenda.plugin.services.BuildAutomationService"/>
    </extensions>

    <actions>
        <action
            id="KmpIosBuildDoctor.FastBuild"
            class="org.redesnac.wilfriedmbouenda.plugin.actions.BuildIOSFastAction"
            text="KMP iOS Doctor: Fast Build"
            description="Run the fastest currently recommended iOS build action">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
